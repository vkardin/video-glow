{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "short_name": "Video Glow",
  "homepage_url": "https://vkardin.github.io/video-glow/",
  "version": "1.6.0",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    { "resources": ["popup.html"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "toggle-glow": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "__MSG_cmdToggle__"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "__MSG_cmdPanel__"
    },
    "toggle-site": {
      "description": "__MSG_cmdSite__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "presets.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
